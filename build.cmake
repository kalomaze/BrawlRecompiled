cmake_minimum_required(VERSION 3.25)
# Run from any directory: cmake -DDISC=/path/to/brawl.iso -P /path/to/build.cmake
if(NOT DEFINED DISC OR NOT EXISTS "${DISC}")
    message(FATAL_ERROR "Usage: cmake -DDISC=/path/to/brawl.iso -P build.cmake")
endif()
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "This build entry point currently supports native Ubuntu Linux.")
endif()
find_program(PYTHON python3 REQUIRED)
if(NOT DEFINED BUILD_DIR)
    set(BUILD_DIR "${CMAKE_CURRENT_LIST_DIR}/build")
endif()
set(args --disc "${DISC}" --build-dir "${BUILD_DIR}" --cmake "${CMAKE_COMMAND}")
if(DEFINED CMAKE_BUILD_TYPE)
    list(APPEND args --build-type "${CMAKE_BUILD_TYPE}")
endif()
if(DEFINED MKW_FLAT_MEMORY)
    if(MKW_FLAT_MEMORY)
        list(APPEND args --flat-memory ON)
    else()
        list(APPEND args --flat-memory OFF)
    endif()
endif()
if(DEFINED MKW_HOST_ISA)
    list(APPEND args --host-isa "${MKW_HOST_ISA}")
endif()
if(DEFINED JOBS)
    list(APPEND args --jobs "${JOBS}")
endif()
execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/tools/build_ubuntu.py" ${args}
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Ubuntu build failed (${result}); see the step output above.")
endif()
